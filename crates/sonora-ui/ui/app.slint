// Sonora application shell.
//
// Library views plus the playback transport and queue. Every control here is
// wired to real behaviour — there are no placeholder buttons.

import { ScrollView, LineEdit, Slider } from "std-widgets.slint";

global Palette {
    // Warm charcoal rather than pure grey, with a amber accent: Sonora's own
    // palette, not a copy of anybody's streaming service.
    out property <color> bg: #17161b;
    out property <color> sidebar: #101015;
    out property <color> panel: #1e1d23;
    out property <color> panel-hover: #2a2831;
    out property <color> stroke: #2e2c35;
    out property <color> text: #f5f3ef;
    out property <color> muted: #a3a0ab;
    out property <color> accent: #f0b13c;
    out property <color> accent-hover: #ffc65a;
    out property <color> accent-soft: #3a2f18;
    // Dark ink on the amber, because white on it is unreadable.
    out property <color> accent-text: #191510;
}

export struct TrackRow {
    id: int,
    title: string,
    artist: string,
    artist-id: int,
    album: string,
    album-id: int,
    // Combined label for places that show extra context (e.g. history time).
    subtitle: string,
    duration: string,
    favourite: bool,
    rating: int,
    replay_gain: string,
}

export struct AlbumRow {
    id: int,
    title: string,
    subtitle: string,
    artist-id: int,
    meta: string,
}

export struct QueueRow {
    title: string,
    artist: string,
    artist-id: int,
    album-id: int,
    subtitle: string,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 38px;
    border-radius: 6px;
    background: root.active ? Palette.panel-hover : (touch.has-hover ? #1a1a1a : transparent);

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        color: root.active ? Palette.text : Palette.muted;
        font-size: 14px;
        font-weight: root.active ? 700 : 400;
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        vertical-alignment: center;
    }
}

component StatCard inherits Rectangle {
    in property <string> value;
    in property <string> caption;

    height: 86px;
    border-radius: 8px;
    background: Palette.panel;

    VerticalLayout {
        padding: 16px;
        spacing: 2px;
        alignment: start;

        Text {
            text: root.value;
            color: Palette.text;
            font-size: 26px;
            font-weight: 600;
        }
        Text {
            text: root.caption;
            color: Palette.muted;
            font-size: 12px;
        }
    }
}

// The label sits in a layout so it is centred in the button instead of pinned
// to the top-left corner, which is what a bare Text inside a Rectangle does.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: true;
    callback clicked();

    height: 36px;
    width: content.preferred-width;
    border-radius: 8px;
    border-width: root.primary ? 0px : 1px;
    border-color: Palette.stroke;
    background: touch.has-hover ? (root.primary ? Palette.accent-hover : Palette.panel-hover) : (root.primary ? Palette.accent : Palette.panel);

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;

        Text {
            text: root.label;
            color: root.primary ? Palette.accent-text : Palette.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Small -/+ beside a slider: dragging is imprecise on a touch screen or a low
// resolution display, and these nudge the value by a fixed step.
component StepButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.stroke;
    background: touch.has-hover && root.enabled ? Palette.panel-hover : Palette.panel;
    opacity: root.enabled ? 1.0 : 0.35;

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    Text {
        text: root.label;
        width: parent.width;
        height: parent.height;
        color: Palette.text;
        font-size: 15px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component EmptyState inherits Rectangle {
    in property <string> message;

    height: 130px;
    border-radius: 8px;
    background: Palette.panel;

    Text {
        text: root.message;
        width: parent.width - 32px;
        height: parent.height;
        x: 16px;
        color: Palette.muted;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

component TrackRowItem inherits Rectangle {
    in property <TrackRow> track;
    in property <int> position: 0;
    in property <bool> show-index: false;

    callback activated(int);
    callback play-next(int);
    callback enqueue(int);
    callback favourite(int, bool);
    callback rate(int, int);
    callback open-album(int);
    callback open-artist(int, string);

    height: 56px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.panel-hover : transparent;

    touch := TouchArea {
        clicked => {
            root.activated(root.track.id);
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;

        Text {
            text: "\{root.position}";
            width: 26px;
            visible: root.show-index;
            color: Palette.muted;
            font-size: 12px;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;

            // Track title opens its release; the row behind still plays on click.
            Rectangle {
                height: 18px;
                background: transparent;
                title-text := Text {
                    text: root.track.title;
                    color: root.track.album-id > 0 && title-touch.has-hover ? Palette.accent : Palette.text;
                    font-size: 14px;
                    overflow: elide;
                }
                title-touch := TouchArea {
                    clicked => {
                        if root.track.album-id > 0 { root.open-album(root.track.album-id); }
                        else { root.activated(root.track.id); }
                    }
                }
            }

            // Artist and album are separate links; history rows append their time.
            HorizontalLayout {
                spacing: 0px;
                height: 16px;

                Rectangle {
                    width: artist-text.preferred-width;
                    background: transparent;
                    artist-text := Text {
                        text: root.track.artist != "" ? root.track.artist : "Unknown Artist";
                        color: root.track.artist-id > 0 && artist-touch.has-hover ? Palette.accent : Palette.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                    artist-touch := TouchArea {
                        clicked => {
                            if root.track.artist-id > 0 {
                                root.open-artist(root.track.artist-id, root.track.artist);
                            }
                        }
                    }
                }

                if root.track.album != "" : Text {
                    text: " · ";
                    color: Palette.muted;
                    font-size: 12px;
                }

                if root.track.album != "" : Rectangle {
                    width: album-text.preferred-width;
                    background: transparent;
                    album-text := Text {
                        text: root.track.album;
                        color: root.track.album-id > 0 && album-touch.has-hover ? Palette.accent : Palette.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                    album-touch := TouchArea {
                        clicked => {
                            if root.track.album-id > 0 { root.open-album(root.track.album-id); }
                        }
                    }
                }

                if root.track.subtitle != "" : Text {
                    text: root.track.album != "" || root.track.artist != "" ? " · \{root.track.subtitle}" : root.track.subtitle;
                    color: Palette.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            Text {
                text: root.track.replay_gain;
                color: Palette.accent;
                font-size: 11px;
                overflow: elide;
                visible: root.track.replay_gain != "";
            }
        }

        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 6px;
            background: next-touch.has-hover ? Palette.accent-soft : transparent;

            Text {
                text: "Next";
                color: Palette.muted;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            next-touch := TouchArea {
                clicked => {
                    root.play-next(root.track.id);
                }
            }
        }

        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 6px;
            background: queue-touch.has-hover ? Palette.accent-soft : transparent;

            Text {
                text: "Add";
                color: Palette.muted;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            queue-touch := TouchArea {
                clicked => {
                    root.enqueue(root.track.id);
                }
            }
        }

        Rectangle {
            width: 28px;
            height: 24px;
            border-radius: 6px;
            background: favourite-touch.has-hover ? Palette.accent-soft : transparent;

            Text {
                text: root.track.favourite ? "♥" : "♡";
                color: root.track.favourite ? Palette.accent : Palette.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            favourite-touch := TouchArea {
                clicked => {
                    root.favourite(root.track.id, !root.track.favourite);
                }
            }
        }

        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 6px;
            background: rating-touch.has-hover ? Palette.accent-soft : transparent;

            Text {
                text: root.track.rating > 0 ? "★ \{root.track.rating}" : "☆";
                color: root.track.rating > 0 ? Palette.accent : Palette.muted;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            rating-touch := TouchArea {
                clicked => {
                    root.rate(root.track.id, root.track.rating);
                }
            }
        }

        Text {
            text: root.track.duration;
            width: 52px;
            color: Palette.muted;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// A whole page of tracks. Every list (Tracks, History, Favourites) behaves the
// same way, so the row wiring lives in one place instead of three copies.
component TrackList inherits ScrollView {
    in property <[TrackRow]> rows;
    in property <string> empty-message: "";

    callback activated(int);
    callback play-next(int);
    callback enqueue(int);
    callback favourite(int, bool);
    callback rate(int, int);
    callback open-album(int);
    callback open-artist(int, string);

    VerticalLayout {
        padding: 24px;
        spacing: 2px;

        if root.rows.length == 0 : EmptyState {
            message: root.empty-message;
        }

        for item[index] in root.rows : TrackRowItem {
            track: item;
            position: index + 1;
            show-index: true;
            activated(id) => { root.activated(id); }
            play-next(id) => { root.play-next(id); }
            enqueue(id) => { root.enqueue(id); }
            favourite(id, starred) => { root.favourite(id, starred); }
            rate(id, rating) => { root.rate(id, rating); }
            open-album(id) => { root.open-album(id); }
            open-artist(id, name) => { root.open-artist(id, name); }
        }
    }
}

component AlbumCard inherits Rectangle {
    in property <AlbumRow> album;

    callback opened(int);
    callback open-artist(int, string);

    height: 78px;
    border-radius: 8px;
    background: touch.has-hover ? Palette.panel-hover : Palette.panel;

    // Opens the release; the artist line sits on top and opens the artist.
    touch := TouchArea {
        clicked => {
            root.opened(root.album.id);
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        alignment: start;

        Text {
            text: root.album.title;
            color: Palette.text;
            font-size: 14px;
            overflow: elide;
        }
        Rectangle {
            height: 16px;
            background: transparent;
            artist-text := Text {
                text: root.album.subtitle;
                color: root.album.artist-id > 0 && artist-touch.has-hover ? Palette.accent : Palette.muted;
                font-size: 12px;
                overflow: elide;
            }
            artist-touch := TouchArea {
                clicked => {
                    if root.album.artist-id > 0 {
                        root.open-artist(root.album.artist-id, root.album.subtitle);
                    } else {
                        root.opened(root.album.id);
                    }
                }
            }
        }
        Text {
            text: root.album.meta;
            color: Palette.muted;
            font-size: 11px;
            overflow: elide;
        }
    }
}

component TransportBar inherits Rectangle {
    in property <string> title: "Nothing playing";
    in property <string> subtitle: "";
    in property <bool> playing: false;
    in property <int> position-ms: 0;
    in property <int> duration-ms: 0;
    in property <string> position-label: "0:00";
    in property <string> duration-label: "0:00";
    in property <float> volume: 1.0;
    in property <image> artwork;
    in property <int> current-count: 0;
    in property <int> upcoming-count: 0;
    in property <int> history-count: 0;
    in property <int> album-id: 0;
    in property <int> artist-id: 0;
    in property <string> artist-name: "";

    callback toggle();
    callback previous();
    callback next();
    callback seek(int);
    callback volume-changed(float);
    callback queue-toggle();
    callback lyrics-toggle();
    callback open-album(int);
    callback open-artist(int, string);

    height: 90px;
    background: Palette.sidebar;
    border-width: 1px;
    border-color: Palette.stroke;

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 16px;

        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 4px;
            background: Palette.stroke;
            clip: true;

            Image {
                source: root.artwork;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
        }

        VerticalLayout {
            width: 210px;
            alignment: center;
            spacing: 2px;

            Rectangle {
                height: 18px;
                background: transparent;
                title-text := Text {
                    text: root.title;
                    color: root.album-id > 0 && title-touch.has-hover ? Palette.accent : Palette.text;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }
                title-touch := TouchArea {
                    clicked => {
                        if root.album-id > 0 { root.open-album(root.album-id); }
                    }
                }
            }
            Rectangle {
                height: 16px;
                background: transparent;
                subtitle-text := Text {
                    text: root.subtitle;
                    color: root.artist-id > 0 && subtitle-touch.has-hover ? Palette.accent : Palette.muted;
                    font-size: 11px;
                    overflow: elide;
                }
                subtitle-touch := TouchArea {
                    clicked => {
                        if root.artist-id > 0 { root.open-artist(root.artist-id, root.artist-name); }
                    }
                }
            }
        }

        ActionButton {
            label: "Prev";
            primary: false;
            clicked => {
                root.previous();
            }
        }

        ActionButton {
            label: root.playing ? "Pause" : "Play";
            clicked => {
                root.toggle();
            }
        }

        ActionButton {
            label: "Next";
            primary: false;
            clicked => {
                root.next();
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            progress := Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Palette.stroke;

                Rectangle {
                    width: root.duration-ms > 0 ? progress.width * (root.position-ms * 1.0 / root.duration-ms) : 0px;
                    border-radius: 2px;
                    background: Palette.accent;
                }

                TouchArea {
                    clicked => {
                        if (root.duration-ms > 0) {
                            root.seek(floor(root.duration-ms * (self.mouse-x / progress.width)));
                        }
                    }
                }
            }

            HorizontalLayout {
                Text {
                    text: root.position-label;
                    color: Palette.muted;
                    font-size: 10px;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.duration-label;
                    color: Palette.muted;
                    font-size: 10px;
                }
            }
        }

        Slider {
            width: 90px;
            minimum: 0;
            maximum: 1;
            value: root.volume;
            changed(value) => {
                root.volume-changed(value);
            }
        }

        ActionButton {
            label: "Lyrics";
            primary: false;
            clicked => {
                root.lyrics-toggle();
            }
        }

        ActionButton {
            label: "Queue";
            primary: false;
            clicked => {
                root.queue-toggle();
            }
        }
    }
}

component QueuePanel inherits Rectangle {
    in property <[QueueRow]> entries;
    in-out property <int> drag-target: 0;

    callback remove(int);
    callback move(int, int);
    callback open-album(int);
    callback open-artist(int, string);

    width: 300px;
    background: Palette.sidebar;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: "Queue";
            color: Palette.text;
            font-size: 15px;
            font-weight: 600;
        }

        Text {
            text: "Drag a row to reorder. Right-click the title for its album, or the artist for their page.";
            color: Palette.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        if root.entries.length == 0 : Text {
            text: "Nothing queued.";
            color: Palette.muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        for entry[index] in root.entries : Rectangle {
            height: 46px;
            border-radius: 8px;
            background: drag-touch.has-hover ? Palette.panel-hover : Palette.panel;

            drag-touch := TouchArea {
                moved => {
                    root.drag-target = max(0, min(root.entries.length - 1, index + floor((self.mouse-y - 23px) / 46px)));
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                        root.move(index, root.drag-target);
                    }
                    // Navigation is right-click only in the queue, so a casual
                    // left click still means "reorder", not "leave this view".
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                        if (self.mouse-y < 23px) {
                            if (entry.album-id > 0) { root.open-album(entry.album-id); }
                        } else if (entry.artist-id > 0) {
                            root.open-artist(entry.artist-id, entry.artist);
                        }
                    }
                }
            }

            VerticalLayout {
                x: 12px;
                width: parent.width - 48px;
                alignment: center;
                spacing: 1px;

                Text {
                    text: entry.title;
                    color: Palette.text;
                    font-size: 12px;
                    overflow: elide;
                }
                Text {
                    text: entry.subtitle;
                    color: Palette.muted;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            remove-touch := TouchArea {
                x: parent.width - 36px;
                y: 10px;
                width: 26px;
                height: 26px;

                clicked => {
                    root.remove(index);
                }
            }

            Text {
                text: "x";
                x: parent.width - 36px;
                y: 10px;
                width: 26px;
                height: 26px;
                color: remove-touch.has-hover ? Palette.text : Palette.muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component LyricsPanel inherits Rectangle {
    in property <string> text: "";
    in property <string> status: "";
    // Synced lyrics arrive as timed lines; the active one follows playback.
    in property <[string]> lines: [];
    in property <int> active: -1;

    callback close();
    callback fetch();

    width: 320px;
    background: Palette.sidebar;

    // Keep the line playback reached in view. Slint has no query for the position
    // of one repeated child, so the active row reports its own offset and the pane
    // scrolls until it sits a third of the way down, without passing either end.
    property <length> active-line-y: 0;
    property <length> active-line-height: 0;

    function follow-line(index: int, y: length, line-height: length) {
        if (index != root.active) {
            return;
        }
        root.active-line-y = y;
        root.active-line-height = line-height;
        root.follow();
    }

    function follow() {
        if (root.active < 0) {
            return;
        }
        lyrics-view.content-y = -max(
            0px,
            min(
                root.active-line-y - (lyrics-view.height - root.active-line-height) / 3,
                lyrics-view.content-height - lyrics-view.height
            )
        );
    }

    // A lyric that starts over, or goes away, begins at the top again.
    changed active => {
        if (active < 0) {
            lyrics-view.content-y = 0;
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: "Lyrics";
                color: Palette.text;
                font-size: 15px;
                font-weight: 600;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            ActionButton {
                label: "Close";
                primary: false;
                clicked => {
                    root.close();
                }
            }
        }

        ActionButton {
            label: "Fetch lyrics";
            primary: false;
            clicked => {
                root.fetch();
            }
        }

        Text {
            text: root.status;
            color: Palette.muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        lyrics-view := ScrollView {
            // Rows are measured a pass after the line that triggered the follow, so
            // settle the offset again once the content reaches its real height.
            changed content-height => {
                root.follow();
            }
            changed height => {
                root.follow();
            }

            if root.lines.length > 0 : VerticalLayout {
                spacing: 6px;
                for line[index] in root.lines : Text {
                    property <bool> current: index == root.active;

                    text: line;
                    color: current ? Palette.accent : Palette.muted;
                    font-size: 12px;
                    font-weight: current ? 600 : 400;
                    wrap: word-wrap;

                    // Layout owns this row's position; hand it over whenever the row
                    // moves or playback arrives at it, so the view can follow along.
                    changed y => {
                        root.follow-line(index, self.y, self.height);
                    }
                    changed current => {
                        root.follow-line(index, self.y, self.height);
                    }
                }
            }
            if root.lines.length == 0 : Text {
                text: root.text;
                color: Palette.text;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

component OnboardingOverlay inherits Rectangle {
    in property <int> step: 0;
    in property <string> folder-path: "";
    in property <string> folder-hint: "Music";
    in property <int> folder-count: 0;
    in property <string> format-tier: "lossless";
    in-out property <float> bitrate: 320;
    in property <string> lastfm-key: "";

    private property <int> bitrate-shown: round(root.bitrate);

    callback next();
    callback back();
    callback finish();
    callback folder-path-changed(string);
    callback add-folder(string);
    callback browse-folder();
    callback tier-changed(string);
    callback bitrate-changed(float);
    callback lastfm-changed(string);

    background: Palette.bg;

    VerticalLayout {
        padding: 64px;
        spacing: 18px;

        Text {
            text: "SONORA";
            color: Palette.muted;
            font-size: 12px;
            letter-spacing: 2px;
        }

        if root.step == 0 : Text {
            text: "Welcome";
            color: Palette.text;
            font-size: 30px;
            font-weight: 600;
        }
        if root.step == 0 : Text {
            text: "Sonora plays the files you already own: no account, no subscription, no web view. It indexes your folders, reads the tags, and keeps the library in a local database.";
            color: Palette.muted;
            font-size: 14px;
            wrap: word-wrap;
        }

        if root.step == 1 : Text {
            text: "Where is your music?";
            color: Palette.text;
            font-size: 32px;
            font-weight: 700;
        }
        if root.step == 1 : Text {
            text: "Point Sonora at one or more folders. Subfolders are included, and re-scanning only touches files that changed.";
            color: Palette.muted;
            font-size: 13px;
            wrap: word-wrap;
        }
        if root.step == 1 : HorizontalLayout {
            spacing: 10px;
            LineEdit {
                text: root.folder-path;
                placeholder-text: root.folder-hint;
                edited(text) => {
                    root.folder-path-changed(text);
                }
                horizontal-stretch: 1;
            }
            ActionButton {
                label: "Browse…";
                primary: false;
                clicked => {
                    root.browse-folder();
                }
            }
            ActionButton {
                label: "Add folder";
                clicked => {
                    root.add-folder(root.folder-path);
                }
            }
        }
        if root.step == 1 : Text {
            text: "\{root.folder-count} folders indexed so far.";
            color: Palette.muted;
            font-size: 12px;
        }

        if root.step == 2 : Text {
            text: "Which files do you prefer?";
            color: Palette.text;
            font-size: 32px;
            font-weight: 700;
        }
        if root.step == 2 : Text {
            text: "This governs downloads, device sync and what the cache keeps. It never changes how files already in your library are played.";
            color: Palette.muted;
            font-size: 13px;
            wrap: word-wrap;
        }
        if root.step == 2 : HorizontalLayout {
            spacing: 10px;
            ActionButton {
                label: "Lossless";
                primary: root.format-tier == "lossless";
                clicked => {
                    root.tier-changed("lossless");
                }
            }
            ActionButton {
                label: "Lossy";
                primary: root.format-tier == "lossy";
                clicked => {
                    root.tier-changed("lossy");
                }
            }
        }
        if root.step == 2 && root.format-tier == "lossy" : Text {
            text: root.bitrate >= 1411 ? "Bitrate ceiling: unlimited — a maximum, never a target." : "Bitrate ceiling: \{root.bitrate-shown} kbit/s — a maximum, never a target.";
            color: Palette.muted;
            font-size: 12px;
        }
        if root.step == 2 && root.format-tier == "lossy" : HorizontalLayout {
            spacing: 8px;
            alignment: center;

            StepButton {
                label: "−";
                enabled: root.bitrate > 32;
                clicked => {
                    root.bitrate = max(32.0, root.bitrate - 32);
                    root.bitrate-changed(root.bitrate);
                }
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 32;
                maximum: 1411;
                value <=> root.bitrate;
            }
            StepButton {
                label: "+";
                enabled: root.bitrate < 1411;
                clicked => {
                    root.bitrate = min(1411.0, root.bitrate + 32);
                    root.bitrate-changed(root.bitrate);
                }
            }
        }

        if root.step == 3 : Text {
            text: "Optional: Last.fm";
            color: Palette.text;
            font-size: 32px;
            font-weight: 700;
        }
        if root.step == 3 : Text {
            text: "Artwork, lyrics and metadata work without any key. A free Last.fm key only adds listener tags and scrobbling, and you can add it later in Settings.";
            color: Palette.muted;
            font-size: 13px;
            wrap: word-wrap;
        }
        if root.step == 3 : LineEdit {
            text: root.lastfm-key;
            placeholder-text: "Last.fm API key (optional)";
            edited(text) => {
                root.lastfm-changed(text);
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Text {
            text: "Step \{root.step + 1} of 4";
            color: Palette.muted;
            font-size: 11px;
        }

        HorizontalLayout {
            spacing: 10px;

            if root.step > 0 : ActionButton {
                label: "Back";
                primary: false;
                clicked => {
                    root.back();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            ActionButton {
                label: "Skip setup";
                primary: false;
                clicked => {
                    root.finish();
                }
            }

            ActionButton {
                label: root.step >= 3 ? "Finish" : "Continue";
                clicked => {
                    if (root.step >= 3) {
                        root.finish();
                    } else {
                        root.next();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Sonora";
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 920px;
    min-height: 600px;
    background: Palette.bg;

    in property <string> section: "home";
    in-out property <string> search-text: "";
    in-out property <string> folder-path: "";
    in property <string> status: "Ready";
    in property <bool> busy: false;
    in property <int> track-count: 0;
    in property <int> album-count: 0;
    in property <int> artist-count: 0;
    in property <string> library-duration: "0:00";
    in property <[TrackRow]> recent-tracks;
    in property <[TrackRow]> all-tracks;
    in property <[TrackRow]> most-played-tracks;
    in property <[TrackRow]> history-tracks;
    in property <[TrackRow]> favourite-tracks;
    in property <[AlbumRow]> albums;
    in property <[TrackRow]> album-tracks;
    in property <string> album-title: "";
    in property <string> album-artist: "";
    in property <int> album-artist-id: 0;
    in property <string> album-meta: "";
    in property <string> album-back: "albums";
    in property <[AlbumRow]> artist-albums;
    in property <[TrackRow]> artist-tracks;
    in property <string> artist-name: "";
    in property <string> artist-meta: "";
    in property <string> artist-back: "albums";
    in property <[string]> folders;

    in property <bool> playback-available: false;
    in property <string> now-playing-title: "Nothing playing";
    in property <string> now-playing-subtitle: "";
    in property <string> now-playing-artist: "";
    in property <int> now-playing-artist-id: 0;
    in property <int> now-playing-album-id: 0;
    in property <bool> playing: false;
    in property <int> position-ms: 0;
    in property <int> duration-ms: 0;
    in property <string> position-label: "0:00";
    in property <string> duration-label: "0:00";
    in property <float> volume: 1.0;
    in property <[QueueRow]> queue-entries;
    in-out property <bool> queue-open: false;
    in-out property <bool> onboarding-open: false;
    in-out property <int> onboarding-step: 0;
    in-out property <bool> lyrics-open: false;
    in property <string> lyrics-text: "";
    in property <string> lyrics-status: "";
    in property <[string]> lyric-lines: [];
    in property <int> lyric-active: -1;
    in property <image> artwork;
    in property <int> current-count: 0;
    in property <int> upcoming-count: 0;
    in property <int> history-count: 0;

    in-out property <string> settings-format-tier: "lossless";
    // float, because these two drive Sliders through a two-way binding: an int
    // property could only be read by the slider, and the -/+ buttons would stop
    // moving it once the user had dragged the handle.
    in-out property <float> settings-bitrate: 320;
    in-out property <float> settings-cache-mib: 4096;
    in-out property <string> settings-artwork-format: "jpg";
    in-out property <int> settings-artwork-quality: 90;
    in-out property <string> settings-folder-template: "{album_artist}/{album}/{track_no:02} {title}";
    in-out property <string> settings-lastfm-key: "";
    in-out property <string> settings-download-folder: "";
    in-out property <string> settings-cache-folder: "";
    in-out property <bool> settings-device-sync: false;
    in-out property <string> settings-device: "";
    in-out property <bool> device-picker-open: false;
    in property <[string]> devices: [];
    in-out property <int> device-picker-selected: 0;

    callback section-changed(string);
    callback search-changed(string);
    callback add-folder(string);
    callback browse-folder();
    callback rescan-requested();

    callback track-activated(int);
    callback play-next-requested(int);
    callback enqueue-requested(int);
    callback favourite-toggled(int, bool);
    callback rating-changed(int, int);
    callback toggle-playback();
    callback previous-track();
    callback next-track();
    callback seek-requested(int);
    callback volume-changed(float);
    callback queue-move(int, int);
    callback queue-remove(int);
    callback save-settings(string, int, int, string, int, string, string, string, string, bool, string);
    callback pick-settings-folder(string);
    callback clear-settings-folder(string);
    callback pick-playback-device();
    callback device-picker-cancel();
    callback device-picker-select(string);
    callback open-album(int);
    callback album-track-activated(int);
    callback play-album();
    callback open-artist(int, string);
    callback artist-track-activated(int);
    callback play-artist();
    callback onboarding-next();
    callback onboarding-back();
    callback onboarding-finish();
    callback run-onboarding();
    callback lyrics-toggle();
    callback lyrics-fetch();

    in property <string> folder-hint: "Music";

    private property <int> bitrate-shown: round(root.settings-bitrate);
    private property <int> cache-shown: round(root.settings-cache-mib);
    private property <string> page-title: root.section == "home" ? "Home" : root.section == "tracks" ? "Tracks" : root.section == "albums" ? "Albums" : root.section == "history" ? "History" : root.section == "favourites" ? "Favourites" : root.section == "album" ? root.album-title : root.section == "artist" ? root.artist-name : root.section == "settings" ? "Settings" : "Library folders";

    Rectangle {
        VerticalLayout {
        HorizontalLayout {
            // -------------------------------------------------------- sidebar
            Rectangle {
                width: 236px;
                background: Palette.sidebar;

                VerticalLayout {
                    padding: 18px;
                    spacing: 6px;

                    HorizontalLayout {
                        height: 54px;
                        spacing: 12px;

                        Image {
                            source: @image-url("../../../assets/branding/logo-mark.svg");
                            width: 26px;
                            height: 32px;
                        }

                        Text {
                            text: "Sonora";
                            color: Palette.text;
                            font-size: 19px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "LIBRARY";
                        color: Palette.muted;
                        font-size: 10px;
                        letter-spacing: 1.2px;
                        height: 30px;
                        vertical-alignment: bottom;
                    }

                    NavItem {
                        label: "Home";
                        active: root.section == "home";
                        clicked => {
                            root.section-changed("home");
                        }
                    }
                    NavItem {
                        label: "Tracks";
                        active: root.section == "tracks";
                        clicked => {
                            root.section-changed("tracks");
                        }
                    }
                    NavItem {
                        label: "Albums";
                        active: root.section == "albums";
                        clicked => {
                            root.section-changed("albums");
                        }
                    }
                    NavItem {
                        label: "History";
                        active: root.section == "history";
                        clicked => {
                            root.section-changed("history");
                        }
                    }
                    NavItem {
                        label: "Favourites";
                        active: root.section == "favourites";
                        clicked => {
                            root.section-changed("favourites");
                        }
                    }
                    NavItem {
                        label: "Library folders";
                        active: root.section == "folders";
                        clicked => {
                            root.section-changed("folders");
                        }
                    }
                    NavItem {
                        label: "Settings";
                        active: root.section == "settings";
                        clicked => {
                            root.section-changed("settings");
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Text {
                        text: root.status;
                        color: Palette.muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            // ----------------------------------------------------------- main
            VerticalLayout {
                Rectangle {
                    height: 64px;
                    background: Palette.bg;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;

                        Text {
                            text: root.page-title;
                            color: Palette.text;
                            font-size: 20px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        LineEdit {
                            width: 280px;
                            text: root.search-text;
                            edited(text) => {
                                root.search-text = text;
                                root.search-changed(text);
                            }
                        }

                        ActionButton {
                            label: root.busy ? "Scanning…" : "Rescan library";
                            primary: false;
                            clicked => {
                                root.rescan-requested();
                            }
                        }
                    }
                }

                // --------------------------------------------------------- home
                if root.section == "home" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                        HorizontalLayout {
                            spacing: 12px;

                            StatCard {
                                value: "\{root.track-count}";
                                caption: "Tracks";
                                horizontal-stretch: 1;
                            }
                            StatCard {
                                value: "\{root.album-count}";
                                caption: "Albums";
                                horizontal-stretch: 1;
                            }
                            StatCard {
                                value: "\{root.artist-count}";
                                caption: "Artists";
                                horizontal-stretch: 1;
                            }
                            StatCard {
                                value: root.library-duration;
                                caption: "Total listening time";
                                horizontal-stretch: 1;
                            }
                        }

                        Text {
                            text: "Recently added";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        if root.recent-tracks.length == 0 : EmptyState {
                            message: "Your library is empty. Open \"Library folders\", paste a path and press Add folder — Sonora will index everything inside it.";
                        }

                        for item[index] in root.recent-tracks : TrackRowItem {
                            track: item;
                            position: index + 1;
                            show-index: true;
                            activated(id) => {
                                root.track-activated(id);
                            }
                            play-next(id) => {
                                root.play-next-requested(id);
                            }
                            enqueue(id) => {
                                root.enqueue-requested(id);
                            }
                            favourite(id, starred) => {
                                root.favourite-toggled(id, starred);
                            }
                            rate(id, rating) => {
                                root.rating-changed(id, rating);
                            }
                            open-album(id) => { root.open-album(id); }
                            open-artist(id, name) => { root.open-artist(id, name); }
                        }

                        if root.most-played-tracks.length > 0 : Text {
                            text: "Most played";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        for item[index] in root.most-played-tracks : TrackRowItem {
                            track: item;
                            position: index + 1;
                            show-index: true;
                            activated(id) => {
                                root.track-activated(id);
                            }
                            play-next(id) => {
                                root.play-next-requested(id);
                            }
                            enqueue(id) => {
                                root.enqueue-requested(id);
                            }
                            favourite(id, starred) => {
                                root.favourite-toggled(id, starred);
                            }
                            rate(id, rating) => {
                                root.rating-changed(id, rating);
                            }
                            open-album(id) => { root.open-album(id); }
                            open-artist(id, name) => { root.open-artist(id, name); }
                        }
                    }
                }

                // ----------------------------------------------------- settings
                if root.section == "settings" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        Text {
                            text: "Playback format";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Lossless prefers FLAC and WAV. Lossy never exceeds the ceiling below, and the ceiling is a maximum, never a target to re-encode up to.";
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Lossless";
                                primary: root.settings-format-tier == "lossless";
                                clicked => {
                                    root.settings-format-tier = "lossless";
                                }
                            }
                            ActionButton {
                                label: "Lossy";
                                primary: root.settings-format-tier == "lossy";
                                clicked => {
                                    root.settings-format-tier = "lossy";
                                }
                            }
                        }
                        if root.settings-format-tier == "lossy" : Text {
                            text: root.settings-bitrate >= 1411 ? "Bitrate ceiling: unlimited" : "Bitrate ceiling: \{root.bitrate-shown} kbit/s";
                            color: Palette.muted;
                            font-size: 12px;
                        }
                        if root.settings-format-tier == "lossy" : HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            StepButton {
                                label: "−";
                                enabled: root.settings-bitrate > 32;
                                clicked => {
                                    root.settings-bitrate = max(32.0, root.settings-bitrate - 32);
                                }
                            }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: 32;
                                maximum: 1411;
                                value <=> root.settings-bitrate;
                            }
                            StepButton {
                                label: "+";
                                enabled: root.settings-bitrate < 1411;
                                clicked => {
                                    root.settings-bitrate = min(1411.0, root.settings-bitrate + 32);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.stroke;
                        }

                        Text {
                            text: "Track cache";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Least recently played tracks are evicted first, and the playing track is never removed.";
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Budget: \{root.cache-shown} MiB";
                            color: Palette.muted;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            StepButton {
                                label: "−";
                                enabled: root.settings-cache-mib > 64;
                                clicked => {
                                    root.settings-cache-mib = max(64.0, root.settings-cache-mib - 256);
                                }
                            }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: 64;
                                maximum: 16384;
                                value <=> root.settings-cache-mib;
                            }
                            StepButton {
                                label: "+";
                                enabled: root.settings-cache-mib < 16384;
                                clicked => {
                                    root.settings-cache-mib = min(16384.0, root.settings-cache-mib + 256);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.stroke;
                        }

                        Text {
                            text: "Download folder";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Where downloaded tracks are written. Leave it on the default to keep them inside the library.";
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: root.settings-download-folder == "" ? "Default (inside the library)" : root.settings-download-folder;
                                color: Palette.muted;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            ActionButton {
                                label: "Browse…";
                                primary: false;
                                clicked => {
                                    root.pick-settings-folder("download");
                                }
                            }
                            ActionButton {
                                label: "Default";
                                primary: false;
                                clicked => {
                                    root.clear-settings-folder("download");
                                }
                            }
                        }

                        Text {
                            text: "Cache folder";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Where cached tracks live. Leave it on the default to use the app data directory.";
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: root.settings-cache-folder == "" ? "Default (app data)" : root.settings-cache-folder;
                                color: Palette.muted;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            ActionButton {
                                label: "Browse…";
                                primary: false;
                                clicked => {
                                    root.pick-settings-folder("cache");
                                }
                            }
                            ActionButton {
                                label: "Default";
                                primary: false;
                                clicked => {
                                    root.clear-settings-folder("cache");
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.stroke;
                        }

                        Text {
                            text: "Artwork";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "JPEG";
                                primary: root.settings-artwork-format == "jpg";
                                clicked => {
                                    root.settings-artwork-format = "jpg";
                                }
                            }
                            ActionButton {
                                label: "PNG";
                                primary: root.settings-artwork-format == "png";
                                clicked => {
                                    root.settings-artwork-format = "png";
                                }
                            }
                        }
                        Text {
                            text: "JPEG quality: \{root.settings-artwork-quality}";
                            color: Palette.muted;
                            font-size: 12px;
                        }
                        Slider {
                            minimum: 1;
                            maximum: 100;
                            value: root.settings-artwork-quality;
                            changed(value) => {
                                root.settings-artwork-quality = round(value);
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.stroke;
                        }

                        Text {
                            text: "Library layout";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        LineEdit {
                            text: root.settings-folder-template;
                            edited(text) => {
                                root.settings-folder-template = text;
                            }
                        }
                        Text {
                            text: "Placeholders: album_artist, album, artist, title, track_no:02, disc_no, year.";
                            color: Palette.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.stroke;
                        }

                        Text {
                            text: "Last.fm";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Optional. Last.fm data needs a free API key; every keyless provider keeps working without one.";
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text: root.settings-lastfm-key;
                            placeholder-text: "API key";
                            edited(text) => {
                                root.settings-lastfm-key = text;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.stroke;
                        }

                        Text {
                            text: "Device sync";
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Opt in to syncing with a device when it is plugged in. Off by default; Android never syncs to an external device.";
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Enabled";
                                primary: root.settings-device-sync;
                                clicked => {
                                    root.settings-device-sync = true;
                                }
                            }
                            ActionButton {
                                label: "Disabled";
                                primary: !root.settings-device-sync;
                                clicked => {
                                    root.settings-device-sync = false;
                                }
                            }
                        }

                        Text {
                            text: "Playback device";
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.settings-device == "" ? "System default" : root.settings-device;
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Change";
                                clicked => {
                                    root.pick-playback-device();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            ActionButton {
                                label: "Save settings";
                                clicked => {
                                    root.save-settings(root.settings-format-tier, root.bitrate-shown, root.cache-shown, root.settings-artwork-format, root.settings-artwork-quality, root.settings-folder-template, root.settings-lastfm-key, root.settings-download-folder, root.settings-cache-folder, root.settings-device-sync, root.settings-device);
                                }
                            }
                            ActionButton {
                                label: "Run onboarding again";
                                primary: false;
                                clicked => {
                                    root.run-onboarding();
                                }
                            }
                            Text {
                                text: root.status;
                                color: Palette.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ------------------------------------------------------- playback device picker
                if root.device-picker-open : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Palette.sidebar;

                    Rectangle {
                        width: 340px;
                        height: 340px;
                        background: Palette.panel;
                        border-radius: 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;

                            Text {
                                text: "Playback device";
                                color: Palette.text;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            ScrollView {
                                height: 220px;

                                VerticalLayout {
                                    spacing: 4px;

                                    for device[index] in root.devices : Rectangle {
                                        height: 40px;
                                        horizontal-stretch: 1;
                                        background: root.device-picker-selected == index ? Palette.accent-soft : transparent;
                                        border-radius: 6px;

                                        Text {
                                            text: device;
                                            color: root.device-picker-selected == index ? Palette.accent : Palette.text;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        touch := TouchArea {
                                            clicked => {
                                                root.device-picker-selected = index;
                                                root.device-picker-select(device);
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 0px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                ActionButton {
                                    label: "Cancel";
                                    clicked => {
                                        root.device-picker-open = false;
                                        root.device-picker-cancel();
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------- tracks
                if root.section == "tracks" : TrackList {
                    rows: root.all-tracks;
                    empty-message: root.search-text == "" ? "No tracks indexed yet." : "No tracks match your search.";
                    activated(id) => {
                        root.track-activated(id);
                    }
                    play-next(id) => {
                        root.play-next-requested(id);
                    }
                    enqueue(id) => {
                        root.enqueue-requested(id);
                    }
                    favourite(id, starred) => {
                        root.favourite-toggled(id, starred);
                    }
                    rate(id, rating) => {
                        root.rating-changed(id, rating);
                    }
                    open-album(id) => { root.open-album(id); }
                    open-artist(id, name) => { root.open-artist(id, name); }
                }

                // ------------------------------------------------------ history
                if root.section == "history" : TrackList {
                    rows: root.history-tracks;
                    empty-message: "Nothing played yet. Start a track and it will show up here.";
                    activated(id) => {
                        root.track-activated(id);
                    }
                    play-next(id) => {
                        root.play-next-requested(id);
                    }
                    enqueue(id) => {
                        root.enqueue-requested(id);
                    }
                    favourite(id, starred) => {
                        root.favourite-toggled(id, starred);
                    }
                    rate(id, rating) => {
                        root.rating-changed(id, rating);
                    }
                    open-album(id) => { root.open-album(id); }
                    open-artist(id, name) => { root.open-artist(id, name); }
                }

                // --------------------------------------------------- favourites
                if root.section == "favourites" : TrackList {
                    rows: root.favourite-tracks;
                    empty-message: "No favourites yet. Press the heart beside a track to keep it here.";
                    activated(id) => {
                        root.track-activated(id);
                    }
                    play-next(id) => {
                        root.play-next-requested(id);
                    }
                    enqueue(id) => {
                        root.enqueue-requested(id);
                    }
                    favourite(id, starred) => {
                        root.favourite-toggled(id, starred);
                    }
                    rate(id, rating) => {
                        root.rating-changed(id, rating);
                    }
                    open-album(id) => { root.open-album(id); }
                    open-artist(id, name) => { root.open-artist(id, name); }
                }

                // ------------------------------------------------------- albums
                if root.section == "albums" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        if root.albums.length == 0 : EmptyState {
                            message: "Albums appear here once tracks with album tags are indexed.";
                        }

                        for item in root.albums : AlbumCard {
                            album: item;
                            opened(id) => { root.open-album(id); }
                            open-artist(id, name) => { root.open-artist(id, name); }
                        }
                    }
                }

                // --------------------------------------------------- album detail
                if root.section == "album" : VerticalLayout {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: root.album-title;
                                    color: Palette.text;
                                    font-size: 18px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    Rectangle {
                                        height: 18px;
                                        width: artist-link.preferred-width;
                                        background: transparent;

                                        artist-link := Text {
                                            text: root.album-artist;
                                            color: artist-touch.has-hover ? Palette.accent : Palette.muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        artist-touch := TouchArea {
                                            clicked => {
                                                root.open-artist(root.album-artist-id, root.album-artist);
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.album-meta;
                                        color: Palette.muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            ActionButton {
                                label: "Back";
                                clicked => {
                                    root.section-changed(root.album-back);
                                }
                            }

                            ActionButton {
                                label: "Play album";
                                primary: true;
                                clicked => {
                                    root.play-album();
                                }
                            }
                        }
                    }

                    TrackList {
                        vertical-stretch: 1;
                        rows: root.album-tracks;
                        empty-message: "This album has no tracks Sonora can play.";
                        activated(id) => {
                            root.album-track-activated(id);
                        }
                        play-next(id) => {
                            root.play-next-requested(id);
                        }
                        enqueue(id) => {
                            root.enqueue-requested(id);
                        }
                        favourite(id, starred) => {
                            root.favourite-toggled(id, starred);
                        }
                        rate(id, rating) => {
                            root.rating-changed(id, rating);
                        }
                        open-album(id) => { root.open-album(id); }
                        open-artist(id, name) => { root.open-artist(id, name); }
                    }
                }

                // -------------------------------------------------- artist detail
                if root.section == "artist" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: root.artist-name;
                                    color: Palette.text;
                                    font-size: 18px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.artist-meta;
                                    color: Palette.muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            ActionButton {
                                label: "Back";
                                clicked => {
                                    root.section-changed(root.artist-back);
                                }
                            }

                            ActionButton {
                                label: "Play all";
                                primary: true;
                                clicked => {
                                    root.play-artist();
                                }
                            }
                        }

                        if root.artist-albums.length > 0 : Text {
                            text: "Albums";
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        for item in root.artist-albums : AlbumCard {
                            album: item;
                            opened(id) => { root.open-album(id); }
                            open-artist(id, name) => { root.open-artist(id, name); }
                        }

                        if root.artist-tracks.length > 0 : Text {
                            text: "Tracks";
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        if root.artist-tracks.length == 0 && root.artist-albums.length == 0 : EmptyState {
                            message: "Nothing by this artist is indexed.";
                        }

                        for item[index] in root.artist-tracks : TrackRowItem {
                            track: item;
                            position: index + 1;
                            show-index: true;
                            activated(id) => {
                                root.artist-track-activated(id);
                            }
                            play-next(id) => {
                                root.play-next-requested(id);
                            }
                            enqueue(id) => {
                                root.enqueue-requested(id);
                            }
                            favourite(id, starred) => {
                                root.favourite-toggled(id, starred);
                            }
                            rate(id, rating) => {
                                root.rating-changed(id, rating);
                            }
                            open-album(id) => { root.open-album(id); }
                            open-artist(id, name) => { root.open-artist(id, name); }
                        }
                    }
                }

                // ------------------------------------------------------ folders
                if root.section == "folders" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        Text {
                            text: "Sonora indexes every supported audio file inside these folders, including subfolders. Re-scanning only touches files that changed.";
                            color: Palette.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            LineEdit {
                                text: root.folder-path;
                                placeholder-text: root.folder-hint;
                                edited(text) => {
                                    root.folder-path = text;
                                }
                                horizontal-stretch: 1;
                            }

                            ActionButton {
                                label: "Browse…";
                                primary: false;
                                clicked => {
                                    root.browse-folder();
                                }
                            }

                            ActionButton {
                                label: "Add folder";
                                clicked => {
                                    root.add-folder(root.folder-path);
                                }
                            }
                        }

                        if root.folders.length == 0 : EmptyState {
                            message: "No library folders yet.";
                        }

                        for folder in root.folders : Rectangle {
                            height: 46px;
                            border-radius: 8px;
                            background: Palette.panel;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;

                                Text {
                                    text: folder;
                                    color: Palette.text;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------------------ queue panel
            if root.lyrics-open : LyricsPanel {
                text: root.lyrics-text;
                status: root.lyrics-status;
                lines: root.lyric-lines;
                active: root.lyric-active;
                close() => {
                    root.lyrics-open = false;
                }
                fetch() => {
                    root.lyrics-fetch();
                }
            }

            if root.queue-open : QueuePanel {
                entries: root.queue-entries;
                remove(index) => {
                    root.queue-remove(index);
                }
                move(from, to) => {
                    root.queue-move(from, to);
                }
                open-album(id) => { root.open-album(id); }
                open-artist(id, name) => { root.open-artist(id, name); }
            }
        }

        // --------------------------------------------------------- transport
        if root.playback-available : TransportBar {
            title: root.now-playing-title;
            subtitle: root.now-playing-subtitle;
            playing: root.playing;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            position-label: root.position-label;
            duration-label: root.duration-label;
            volume: root.volume;
            artwork: root.artwork;
            current-count: root.current-count;
            upcoming-count: root.upcoming-count;
            history-count: root.history-count;

            toggle() => {
                root.toggle-playback();
            }
            previous() => {
                root.previous-track();
            }
            next() => {
                root.next-track();
            }
            seek(ms) => {
                root.seek-requested(ms);
            }
            volume-changed(value) => {
                root.volume-changed(value);
            }
            queue-toggle() => {
                root.queue-open = !root.queue-open;
            }
            lyrics-toggle() => {
                root.lyrics-toggle();
            }
            open-album(id) => { root.open-album(id); }
            open-artist(id, name) => { root.open-artist(id, name); }
        }
        }

        if root.onboarding-open : OnboardingOverlay {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            step: root.onboarding-step;
            folder-path: root.folder-path;
            folder-hint: root.folder-hint;
            folder-count: root.folders.length;
            format-tier: root.settings-format-tier;
            bitrate: root.settings-bitrate;
            lastfm-key: root.settings-lastfm-key;

            folder-path-changed(text) => {
                root.folder-path = text;
            }
            add-folder(path) => {
                root.add-folder(path);
            }
            browse-folder() => {
                root.browse-folder();
            }
            tier-changed(tier) => {
                root.settings-format-tier = tier;
            }
            bitrate-changed(value) => {
                root.settings-bitrate = value;
            }
            lastfm-changed(key) => {
                root.settings-lastfm-key = key;
            }
            next() => {
                root.onboarding-next();
            }
            back() => {
                root.onboarding-back();
            }
            finish() => {
                root.onboarding-finish();
            }
        }
    }
}
